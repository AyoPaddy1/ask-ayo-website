{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ask-ayo.com"
        }
      ],
      "destination": "https://www.ask-ayo.com/:path*",
      "permanent": true
    },
    {
      "source": "/examples",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/earnings",
      "destination": "/investing",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
